<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>연세대학교 사회학과 동문회</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;900&family=Noto+Serif+KR:wght@500;600;700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#003C7E; --navy-d:#00274F; --navy-l:#0A5199;
    --gold:#A6832F; --gold-soft:#BFA35E;
    --paper:#F3F6FA; --card:#FFFFFF; --line:#E2E8F1;
    --ink:#191D24; --muted:#5C6675; --muted-l:#8A93A2;
    --maxw:1120px;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{font-family:"Noto Sans KR",sans-serif;color:var(--ink);background:#fff;line-height:1.7;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  h1,h2,h3,.serif{font-family:"Noto Serif KR",serif}
  img{max-width:100%;display:block}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}

  /* Top util */
  .util{background:var(--navy-d);color:#cdd7e5;font-size:12.5px}
  .util .wrap{display:flex;justify-content:flex-end;align-items:center;gap:16px;height:36px}
  .util a{color:#cdd7e5;transition:color .15s}
  .util a:hover{color:#fff}
  .util .sep{color:#3d567c}
  .util .lang b{color:#fff}

  /* Header / nav */
  header{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:50}
  .head{display:flex;align-items:center;justify-content:space-between;height:78px;gap:18px}
  .brand{display:flex;align-items:center;gap:13px;flex:0 0 auto}
  .crest{width:42px;height:42px;border-radius:50%;background:radial-gradient(circle at 50% 38%, #0a5199 0 42%, transparent 43%),var(--navy);display:flex;align-items:center;justify-content:center;flex:0 0 auto;box-shadow:0 0 0 2px #fff,0 0 0 3px var(--navy)}
  .crest span{color:#fff;font-family:"Noto Serif KR",serif;font-weight:900;font-size:15px;letter-spacing:-1px}
  .brand .txt b{display:block;font-family:"Noto Serif KR",serif;font-weight:700;font-size:19px;color:var(--navy);letter-spacing:-.5px;line-height:1.2}
  .brand .txt small{display:block;font-size:10.5px;letter-spacing:1.8px;color:var(--muted-l);font-weight:500;text-transform:uppercase}
  nav.main{display:flex;gap:2px;flex-wrap:wrap;justify-content:flex-end}
  nav.main > a{padding:9px 13px;font-size:15px;font-weight:500;color:#2a3340;border-radius:6px;transition:.15s;position:relative;white-space:nowrap}
  nav.main > a:hover{color:var(--navy);background:var(--paper)}
  nav.main > a.active{color:var(--navy);font-weight:700}
  nav.main > a.active::after{content:"";position:absolute;left:13px;right:13px;bottom:-1px;height:3px;background:var(--gold);border-radius:2px}
  .burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px}
  .burger i{width:24px;height:2px;background:var(--navy);display:block;transition:.2s}
  #mnav{display:none}

  /* Hero */
  .hero{position:relative;background:linear-gradient(120deg,var(--navy-d),var(--navy) 55%,var(--navy-l));color:#fff;overflow:hidden}
  .hero::before{content:"";position:absolute;inset:0;background:radial-gradient(1200px 400px at 80% -10%, rgba(191,163,94,.25), transparent 60%),repeating-linear-gradient(115deg, rgba(255,255,255,.03) 0 2px, transparent 2px 26px);pointer-events:none}
  .hero .wrap{position:relative;padding:68px 24px 58px}
  .hero .eyebrow{display:inline-flex;align-items:center;gap:9px;font-size:12.5px;letter-spacing:3px;font-weight:600;color:var(--gold-soft);text-transform:uppercase;margin-bottom:18px}
  .hero .eyebrow::before{content:"";width:30px;height:1.5px;background:var(--gold-soft)}
  .hero h1{font-size:clamp(29px,5vw,48px);font-weight:900;line-height:1.22;letter-spacing:-1px}
  .hero h1 .em{color:var(--gold-soft)}
  .hero p.lead{margin-top:20px;font-size:17px;color:#d6e0ee;max-width:640px;font-weight:300;line-height:1.85}
  .hero .cta{margin-top:30px;display:flex;gap:12px;flex-wrap:wrap}
  .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:7px;font-weight:700;font-size:14.5px;transition:.18s;cursor:pointer;border:none;white-space:nowrap}
  .cta{display:flex;gap:12px;flex-wrap:wrap}
  .btn.gold{background:var(--gold);color:#fff}
  .btn.gold:hover{background:#8f6e22}
  .btn.ghost{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.3)}
  .btn.ghost:hover{background:rgba(255,255,255,.16)}
  .btn.navy{background:var(--navy);color:#fff}
  .btn.navy:hover{background:var(--navy-l)}
  .btn.line{background:#fff;color:var(--navy);border:1px solid var(--line)}
  .btn.line:hover{border-color:var(--gold-soft);color:var(--gold)}
  .hero .stats{margin-top:46px;display:flex;gap:40px;flex-wrap:wrap;border-top:1px solid rgba(255,255,255,.15);padding-top:24px}
  .hero .stats .s b{font-family:"Noto Serif KR",serif;font-size:27px;font-weight:700;color:#fff;display:block;line-height:1}
  .hero .stats .s span{font-size:12.5px;color:#a9b8cc;letter-spacing:.4px}

  /* Section shells */
  section{padding:70px 0}
  .sec-head{margin-bottom:36px}
  .sec-head .kicker{font-size:12.5px;letter-spacing:3px;font-weight:700;color:var(--gold);text-transform:uppercase;margin-bottom:11px}
  .sec-head h2{font-size:clamp(24px,3.4vw,33px);font-weight:700;color:var(--navy-d);letter-spacing:-.6px}
  .sec-head .sub{margin-top:11px;color:var(--muted);font-size:15.5px;max-width:680px}
  .alt{background:var(--paper)}

  /* details / 더보기 */
  .more{border:1px solid var(--line);border-radius:10px;margin-top:16px;background:#fff;overflow:hidden}
  .more>summary{cursor:pointer;list-style:none;padding:15px 20px;font-weight:600;color:var(--navy);display:flex;justify-content:space-between;align-items:center;font-size:14.5px;transition:.15s}
  .more>summary:hover{background:var(--paper)}
  .more>summary::-webkit-details-marker{display:none}
  .more>summary .chev{transition:transform .22s;color:var(--gold);font-size:12px}
  .more[open]>summary .chev{transform:rotate(180deg)}
  .more[open]>summary{border-bottom:1px solid var(--line)}
  .more .inner{padding:22px 20px}
  .more .inner p{font-size:14.5px;color:#39424f;line-height:1.85}
  .more .inner p+p{margin-top:11px}

  /* 인사말 */
  .greet{display:grid;grid-template-columns:290px 1fr;gap:50px;align-items:start}
  .greet .photowrap{position:relative}
  .greet .photo{width:100%;border-radius:12px;aspect-ratio:357/457;object-fit:cover;box-shadow:0 22px 44px -22px rgba(0,40,80,.55);background:var(--paper)}
  .greet .cap{margin-top:14px;text-align:center}
  .greet .cap .role{font-size:12px;letter-spacing:2px;color:var(--gold);font-weight:700}
  .greet .cap .nm{font-family:"Noto Serif KR",serif;font-size:22px;font-weight:700;color:var(--navy-d);margin-top:2px}
  .greet .cap .no{font-size:13px;color:var(--muted-l)}
  .greet blockquote{font-family:"Noto Serif KR",serif;font-size:22px;font-weight:600;line-height:1.62;color:var(--navy-d);letter-spacing:-.4px}
  .greet blockquote .hl{color:var(--gold);border-bottom:2px solid var(--gold-soft)}
  .greet .body{margin-top:20px;color:#39424f;font-size:15.5px;line-height:1.95}
  .greet .body p+p{margin-top:14px}
  .greet .sign{margin-top:24px;font-size:14.5px;color:var(--muted)}
  .greet .sign b{color:var(--navy-d);font-family:"Noto Serif KR",serif;font-size:18px}

  /* 임원진 */
  .board-lbl{font-size:13px;font-weight:700;color:var(--gold);letter-spacing:1px;margin:0 0 14px;text-transform:uppercase}
  .lead-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:26px}
  .ocard{background:var(--card);border:1px solid var(--line);border-radius:11px;padding:20px 22px;transition:.18s}
  .ocard:hover{border-color:var(--gold-soft);box-shadow:0 14px 30px -24px rgba(0,40,80,.4)}
  .ocard .r{font-size:12.5px;color:var(--muted);font-weight:600;margin-bottom:6px}
  .ocard .n{font-family:"Noto Serif KR",serif;font-size:20px;font-weight:700;color:var(--navy-d)}
  .ocard .no{font-size:13px;color:var(--gold);font-weight:600;margin-left:6px}
  .ocard.lead2{border-top:3px solid var(--navy)}
  .div-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .ocard.sm{padding:16px 18px}
  .ocard.sm .n{font-size:17px}
  .todo{background:var(--paper);border:1px dashed var(--line);border-radius:11px;padding:16px 18px;display:flex;align-items:center;color:var(--muted);font-size:14px}

  /* 회칙 accordion */
  .ch{border-bottom:1px solid var(--line);padding:16px 0}
  .ch b.t{display:block;font-size:15.5px;color:var(--navy-d);margin-bottom:4px}
  .ch .no{color:var(--gold);font-weight:700;font-size:13px;margin-right:8px}
  .ch p{font-size:14px;color:var(--muted);line-height:1.8}
  .ch ul{margin:8px 0 0 2px;list-style:none}
  .ch ul li{font-size:14px;color:#3a4553;padding:4px 0 4px 16px;position:relative;line-height:1.7}
  .ch ul li::before{content:"·";position:absolute;left:2px;color:var(--gold);font-weight:700}

  /* 활동 */
  .events{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
  .ev{display:flex;gap:18px;background:var(--card);border:1px solid var(--line);border-left:4px solid var(--navy);border-radius:10px;padding:20px 22px;transition:.18s}
  .ev:hover{border-left-color:var(--gold);box-shadow:0 12px 26px -20px rgba(0,40,80,.4)}
  .ev .when{flex:0 0 66px;text-align:center}
  .ev .when b{display:block;font-family:"Noto Serif KR",serif;font-size:21px;color:var(--navy);font-weight:700;line-height:1}
  .ev .when span{font-size:12px;color:var(--muted-l)}
  .ev .what b{font-size:16px;color:var(--navy-d)}
  .ev .what p{font-size:13.5px;color:var(--muted);margin-top:3px}
  .gallery{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:26px}
  .gphoto{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fff;transition:.2s}
  .gphoto:hover{box-shadow:0 16px 34px -24px rgba(0,40,80,.45)}
  .gphoto img{width:100%;display:block}
  .gphoto .cap{padding:13px 16px;font-size:14.5px;font-weight:600;color:var(--navy-d);border-top:1px solid var(--line);display:flex;align-items:center;gap:9px}
  .gphoto .cap::before{content:"";width:8px;height:8px;border-radius:2px;background:var(--gold);flex:0 0 auto}

  /* 동문 모임 */
  .mtgs{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
  .mtg{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:26px;transition:.2s;display:flex;flex-direction:column}
  .mtg:hover{box-shadow:0 18px 38px -26px rgba(0,40,80,.5);transform:translateY(-3px)}
  .mtg .eb{font-size:11.5px;letter-spacing:1.5px;font-weight:700;color:var(--gold);text-transform:uppercase;margin-bottom:8px}
  .mtg h3{font-size:20px;color:var(--navy-d);line-height:1.35;margin-bottom:8px}
  .mtg .meta{font-size:12.5px;color:var(--muted-l);margin-bottom:12px}
  .mtg .blurb{font-size:14.5px;color:#414a57;line-height:1.85;flex:1}
  .mtg .stat3{display:flex;gap:18px;margin-top:14px;padding-top:14px;border-top:1px solid var(--line)}
  .mtg .stat3 .st b{display:block;font-family:"Noto Serif KR",serif;color:var(--navy);font-size:15px}
  .mtg .stat3 .st span{font-size:11.5px;color:var(--muted-l)}
  .mtg .acts{display:flex;gap:8px;margin-top:16px;flex-wrap:wrap}
  .booklist{list-style:none;margin-top:6px}
  .booklist li{font-size:13.5px;color:#3a4553;padding:3px 0 3px 16px;position:relative}
  .booklist li::before{content:"📖";position:absolute;left:-2px;font-size:11px}
  .quote-mini{background:var(--paper);border-left:3px solid var(--gold-soft);border-radius:0 8px 8px 0;padding:12px 16px;margin-top:10px}
  .quote-mini p{font-size:13.5px;color:#414a57;line-height:1.7;margin:0}
  .quote-mini .who{font-size:12px;color:var(--muted-l);margin-top:6px}
  .fund{background:#fbf7ee;border:1px solid var(--gold-soft);border-radius:10px;padding:16px 18px;margin-top:14px}
  .fund .ft{color:var(--gold);font-size:14.5px;font-weight:700;display:block;margin-bottom:6px}
  .fund p{font-size:13.5px;color:#414a57;line-height:1.7;margin:0}
  .fund .acct{display:flex;justify-content:space-between;gap:10px;align-items:baseline;margin-top:11px;padding-top:11px;border-top:1px dashed var(--gold-soft);font-size:13.5px;flex-wrap:wrap}
  .fund .acct span{color:var(--muted);flex:0 0 auto}
  .fund .acct .no2{color:var(--navy-d);font-weight:700;font-size:14.5px;font-family:"Noto Serif KR",serif}
  .fund .acct .no2 small{color:var(--muted-l);font-weight:400;font-family:"Noto Sans KR",sans-serif}
  .fund .tax{margin-top:9px;font-size:12px;color:var(--muted-l)}
  .committee{background:var(--paper);border:1px solid var(--line);border-radius:9px;padding:12px 15px;margin-top:14px}
  .committee b{display:block;font-size:13px;color:var(--navy-d);margin-bottom:4px}
  .committee b small{color:var(--muted-l);font-weight:400;font-size:11.5px}
  .committee span{font-size:13.5px;color:#414a57;line-height:1.65}

  /* 학과 소개 timeline */
  .dept{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}
  .dept .badge{display:inline-block;background:var(--navy);color:#fff;font-size:13px;font-weight:600;padding:7px 15px;border-radius:20px;margin-bottom:16px}
  .dept .lead-t{font-family:"Noto Serif KR",serif;font-size:26px;font-weight:700;color:var(--navy-d);line-height:1.4;margin-bottom:14px}
  .dept p{font-size:14.5px;color:var(--muted);line-height:1.9}
  .tl{list-style:none}
  .tl li{display:flex;gap:18px;padding:12px 0;border-bottom:1px solid var(--line)}
  .tl .yr{font-family:"Noto Serif KR",serif;font-weight:700;color:var(--gold);flex:0 0 60px;font-size:16px}
  .tl .tx{font-size:14px;color:#3a4553;line-height:1.65}
  .tl .tx b{color:var(--navy-d)}

  /* 동문회보 */
  .zines{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
  .zine{display:flex;gap:22px;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:#fff;transition:.2s;padding:22px}
  .zine:hover{box-shadow:0 18px 38px -26px rgba(0,40,80,.5);border-color:var(--gold-soft)}
  .zine .cov{flex:0 0 108px;aspect-ratio:3/4;border-radius:8px;position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:14px;color:#fff}
  .zine .cov.v1{background:linear-gradient(160deg,#4a2b1a,#a6832f)}
  .zine .cov.v2{background:linear-gradient(160deg,#00274F,#0A5199)}
  .zine .cov .top{font-size:9px;letter-spacing:1.5px;opacity:.85;font-weight:600}
  .zine .cov .mid b{font-family:"Noto Serif KR",serif;font-size:16px;font-weight:700;display:block;line-height:1.25}
  .zine .cov .frm{position:absolute;inset:9px;border:1px solid rgba(255,255,255,.22);border-radius:5px;pointer-events:none}
  .zine .zi{flex:1;display:flex;flex-direction:column;justify-content:center}
  .zine .zi .vol{font-size:12px;color:var(--gold);font-weight:700;letter-spacing:.5px}
  .zine .zi h3{font-size:19px;color:var(--navy-d);margin:5px 0 4px;line-height:1.3}
  .zine .zi .dt{font-size:13px;color:var(--muted-l);margin-bottom:14px}

  /* 기부 */
  .thanks{background:linear-gradient(120deg,var(--navy-d),var(--navy));color:#fff;border-radius:16px;padding:38px 40px;position:relative;overflow:hidden}
  .thanks::before{content:"";position:absolute;inset:0;background:radial-gradient(600px 300px at 90% 0, rgba(191,163,94,.22), transparent 60%)}
  .thanks .rel{position:relative}
  .thanks h3{font-size:24px;font-weight:700;margin-bottom:12px}
  .thanks p{font-size:15px;color:#d6e0ee;line-height:1.85;max-width:760px}
  .tier{display:grid;grid-template-columns:130px 1fr;gap:8px 20px;padding:16px 0;border-bottom:1px solid var(--line);align-items:start}
  .tier .amt{font-family:"Noto Serif KR",serif;font-weight:700;color:var(--navy);font-size:15px}
  .tier .amt small{display:block;font-size:11px;color:var(--muted-l);font-weight:400;font-family:"Noto Sans KR"}
  .tier .ppl{font-size:14px;color:#3a4553;line-height:1.9}
  .gift-tbl{width:100%;border-collapse:collapse;margin-top:8px;font-size:13.5px}
  .gift-tbl th,.gift-tbl td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--line);vertical-align:top}
  .gift-tbl th{background:var(--navy);color:#fff;font-weight:600;font-size:12.5px}
  .gift-tbl td.no{color:var(--gold);font-weight:700;white-space:nowrap;font-family:"Noto Serif KR"}
  .gift-tbl td.nm{color:var(--navy-d);font-weight:500;white-space:nowrap}
  .gift-tbl tr:nth-child(even) td{background:#fafbfd}

  /* 회비 + 문의 */
  .split{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:stretch}
  .panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:30px 30px}
  .panel h3{font-size:20px;color:var(--navy-d);margin-bottom:8px}
  .panel .p{font-size:14.5px;color:var(--muted);line-height:1.85;margin-bottom:18px}
  .fee .amt{font-family:"Noto Serif KR",serif;color:var(--navy);margin-bottom:14px}
  .fee .amt b{font-size:40px;font-weight:900}
  .fee .amt span{font-size:15px;color:var(--muted)}
  .kv{display:flex;justify-content:space-between;font-size:14.5px;padding:9px 0;border-top:1px solid var(--line)}
  .kv span{color:var(--muted)}.kv b{color:var(--navy-d);font-weight:600}
  .contact .big{font-family:"Noto Serif KR",serif;font-size:17px;color:var(--navy-d);margin:14px 0 4px}
  .contact a.mail{color:var(--gold);font-weight:600}

  /* Footer */
  footer{background:var(--navy-d);color:#aab8cc;padding:52px 0 30px;font-size:14px}
  .fcols{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:40px;padding-bottom:32px;border-bottom:1px solid rgba(255,255,255,.12)}
  .fcols .fb b{font-family:"Noto Serif KR",serif;color:#fff;font-size:18px;display:block;margin-bottom:14px}
  .fcols .fb p{line-height:1.9;color:#8ea0b8}
  .fcols h4{color:#fff;font-size:14px;margin-bottom:14px;font-weight:700}
  .fcols ul{list-style:none}.fcols ul li{padding:5px 0}.fcols ul a:hover{color:#fff}
  .fbot{padding-top:22px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;color:#6f829c;font-size:12.5px}

  .demo{background:#fff7e8;border-bottom:1px solid #f0dcae;color:#8a6d1f;font-size:13px;text-align:center;padding:9px 16px}
  .demo b{color:#6f5312}

  /* Responsive */
  @media(max-width:960px){
    nav.main{display:none}
    .burger{display:flex}
    #mnav.open{display:block;border-top:1px solid var(--line);padding:8px 0 12px}
    #mnav a{display:block;padding:11px 24px;font-size:15.5px;color:#2a3340;font-weight:500}
    #mnav a:active{background:var(--paper)}
    .greet,.split,.dept{grid-template-columns:1fr}
    .greet .photowrap{max-width:280px;margin:0 auto}
    .lead-row{grid-template-columns:1fr}
    .div-grid{grid-template-columns:repeat(2,1fr)}
    .events,.mtgs,.zines{grid-template-columns:1fr}
    .gallery{grid-template-columns:1fr}
    .fcols{grid-template-columns:1fr;gap:26px}
    .zine{flex-direction:column}
    .zine .cov{flex:0 0 auto;width:140px}
    .zine .zi{width:100%}
    .fund .acct{flex-direction:column;gap:5px;align-items:flex-start}
    .fund .acct .no2{word-break:keep-all;line-height:1.5}
  }
  @media(max-width:520px){
    section{padding:52px 0}
    .div-grid{grid-template-columns:1fr}
    .hero .stats{gap:22px}
    .thanks{padding:28px 24px}
    .tier{grid-template-columns:1fr;gap:2px}
